<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <link rel="stylesheet" href="/css/about.css">
    
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    
    <title>About - Urban Bites</title>

    <style>
        /* Aesthetic Overrides */
        body {
            font-family: 'Roboto', sans-serif;
            color: #333;
        }
        h1, h2, h3, h4, h5 {
            font-family: 'Playfair Display', serif;
        }
        .feature-icon {
            font-size: 2rem;
            color: #d4af37; /* Gold branding color */
            margin-bottom: 15px;
        }
        .feature-card {
            padding: 20px;
            border-radius: 10px;
            transition: transform 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.5);
        }
        .carousel-container {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            margin: 40px auto;
            max-width: 800px;
        }
        .info-icon {
            color: #d4af37;
            margin-right: 10px;
        }
        .container {
            /* Ensuring your existing glassmorphism looks good with new content */
            max-width: 900px; 
        }
    </style>
</head>
<body>
    <nav>
        <ul class="nav-flex-row">
            <li><a href="/index">Home Page</a></li>
            <li><a href="/reservation">Reservation</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/delivery">Home Delivery</a></li>
            <li><a href="/about">About</a></li>
        </ul>
    </nav>

    <section class="about-section mt-5 pt-5">
        <div class="container text-center">
            
            <div class="mb-5">
                <h1 class="display-4 font-weight-bold">Our Story</h1>
                <p class="lead text-muted">Commitment to quality, atmosphere, and unique flavors.</p>
                <hr class="w-25 mx-auto border-warning">
            </div>

            <div class="row text-left">
                <div class="col-12 text-center mb-4">
                    <h3>Why We Are The Best</h3>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-carrot feature-icon"></i>
                        <h5>Fresh Ingredients</h5>
                        <p class="small text-muted">We prioritize freshness, using locally-sourced ingredients to ensure top quality.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-utensils feature-icon"></i>
                        <h5>Culinary Expertise</h5>
                        <p class="small text-muted">Our chefs craft dishes that are innovative yet rooted in tradition.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-glass-cheers feature-icon"></i>
                        <h5>Inviting Atmosphere</h5>
                        <p class="small text-muted">Every detail is designed to make you feel comfortable and welcomed.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-concierge-bell feature-icon"></i>
                        <h5>Personalized Service</h5>
                        <p class="small text-muted">Warm, attentive, and personalized experience for each guest.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-book-open feature-icon"></i>
                        <h5>Diverse Menu</h5>
                        <p class="small text-muted">A variety of dishes catering to all palates and dietary preferences.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="feature-card text-center">
                        <i class="fas fa-star feature-icon"></i>
                        <h5>Consistent Quality</h5>
                        <p class="small text-muted">We strive for excellence, ensuring high-quality experiences every visit.</p>
                    </div>
                </div>
                
                <div class="col-md-12 mb-4">
                    <div class="feature-card text-center w-50 mx-auto">
                        <i class="fas fa-leaf feature-icon"></i>
                        <h5>Sustainability</h5>
                        <p class="small text-muted">Eco-friendly initiatives, from minimal food waste to sustainable sourcing.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="container p-0 bg-transparent shadow-none" style="background: none; box-shadow: none;">
        <div id="carouselExampleControls" class="carousel slide carousel-container" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/img/rachel-park-hrlvr2ZlUNk-unsplash.jpg" class="d-block w-100" alt="Delicious Breakfast">
                </div>
                <div class="carousel-item">
                    <img src="/img/lily-banse--YHSwy6uqvk-unsplash.jpg" class="d-block w-100" alt="Exquisite Dinner">
                </div>
                <div class="carousel-item">
                    <img src="/img/brooke-lark-aGjP08-HbYY-unsplash.jpg" class="d-block w-100" alt="Healthy Options">
                </div>
            </div>
            <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="text-center h-100 d-flex flex-column justify-content-center">
                    <h3 class="mb-3"><i class="far fa-clock info-icon"></i>Opening Times</h3>
                    <p class="mb-1"><strong>Mon — Thu:</strong> 08:00 — 22:00</p>
                    <p class="mb-1"><strong>Fri — Sat:</strong> 09:00 — 23:00</p>
                    <p><strong>Sunday:</strong> 10:00 — 17:00</p>
                </div>
            </div>

            <div class="col-md-6 mb-4 border-left-md border-secondary">
                <div class="text-center h-100 d-flex flex-column justify-content-center">
                    <h3 class="mb-3"><i class="fas fa-map-marker-alt info-icon"></i>Contact Us</h3>
                    <p class="mb-1"><i class="fas fa-phone-alt small mr-2"></i>9283438456</p>
                    <p class="mb-1">1312, Hanumanthnagar,</p>
                    <p class="mb-1">Mount Joy Extension, Bangalore (560050)</p>
                    <a href="mailto:urbanbites@support.in" class="text-dark font-weight-bold mt-2">
                        <i class="fas fa-envelope mr-1"></i> urbanbites@support.in
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
</body>
</html>