<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Urban Bites - Login</title>
    
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <style>
        body {
            font-family: 'Roboto', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: url('/img/petr-sevcovic-qE1jxYXiwOA-unsplash.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Dark Overlay for readability */
        .bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 0;
        }

        .login-card {
            position: relative;
            z-index: 1;
            background: white;
            width: 100%;
            max-width: 400px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            animation: slideUp 0.8s ease-out;
        }

        .card-header-custom {
            background-color: #d4af37;
            padding: 30px 20px;
            text-align: center;
            color: white;
            border: none;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            margin-bottom: 5px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        }

        .card-body {
            padding: 40px 30px;
        }

        /* Form Styling */
        .input-group-text {
            background-color: #fff;
            border-right: none;
            color: #999;
            border-color: #ced4da;
        }

        .form-control {
            border-left: none;
            height: 45px;
            border-color: #ced4da;
            padding-left: 0;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #d4af37;
        }

        .form-control:focus + .input-group-prepend .input-group-text,
        .input-group:focus-within .input-group-text {
            border-color: #d4af37;
            color: #d4af37;
        }

        /* Button Styling */
        .btn-login {
            background-color: #333;
            color: white;
            border-radius: 8px;
            padding: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            transition: all 0.3s;
        }

        .btn-login:hover {
            background-color: #d4af37;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.4);
        }

        /* Links */
        .forgot-link {
            font-size: 0.9rem;
            color: #d4af37;
            font-weight: 500;
            text-decoration: none;
        }
        .forgot-link:hover {
            color: #b39025;
            text-decoration: underline;
        }

        .signup-link {
            color: #d4af37;
            font-weight: 700;
            text-decoration: none;
        }
        .signup-link:hover {
            text-decoration: underline;
            color: #b39025;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="bg-overlay"></div>

    <div class="login-card">
        <div class="card-header-custom">
            <h1 class="brand-title">Urban Bites</h1>
            <p class="mb-0 small text-white-50">Taste the Elegance</p>
        </div>
        
        <div class="card-body">
            <h4 class="text-center mb-4 font-weight-bold text-dark">Welcome Back</h4>
            
            <form method="post" action="/login">
                <div class="form-group mb-4">
                    <label for="username" class="sr-only">Username</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                        </div>
                        <input type="text" class="form-control" id="username" name="username" placeholder="Username" required>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="password" class="sr-only">Password</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        </div>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="rememberMe">
                        <label class="custom-control-label small text-muted" for="rememberMe">Remember me</label>
                    </div>
                    <a href="/forgotPassword" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-login btn-block">Login</button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <p class="small text-muted mb-0">Don't have an account? 
                    <a href="/signup" class="signup-link">Sign Up</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>