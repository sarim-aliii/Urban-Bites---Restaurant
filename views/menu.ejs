<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
  
  <link rel="stylesheet" href="/css/menu.css">

  <title>Menu - Urban Bites</title>

  <style>
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f8f9fa;
        color: #333;
    }
    
    /* Navigation - Fixed & Visible */
    nav {
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 15px 0;
        position: sticky;
        top: 0;
        z-index: 1050;
    }
    .nav-flex-row {
        display: flex;
        justify-content: center;
        list-style: none;
        padding: 0;
        margin: 0;
        flex-wrap: wrap;
    }
    .nav-item {
        margin: 0 15px;
    }
    .nav-item a {
        text-decoration: none;
        color: #333 !important;
        font-weight: 500;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
        transition: color 0.3s;
    }
    .nav-item a:hover {
        color: #d4af37 !important;
    }

    /* Header */
    .menu-header {
        text-align: center;
        padding: 60px 0 40px;
    }
    .menu-header h2 {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        color: #333;
        margin-bottom: 10px;
    }
    .divider {
        width: 80px;
        height: 3px;
        background-color: #d4af37;
        margin: 20px auto;
    }

    /* Menu Cards */
    .menu-card {
        background: white;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        border-top: 3px solid transparent;
    }
    
    .menu-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        border-top: 3px solid #d4af37;
    }

    .category-title {
        font-family: 'Playfair Display', serif;
        color: #333;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 15px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    
    .category-icon {
        color: #d4af37;
        margin-right: 15px;
        font-size: 1.2em;
    }

    /* Menu List Items */
    .menu-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .menu-list li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 15px;
    }

    .menu-item-name {
        font-weight: 500;
        position: relative;
        padding-right: 10px;
        background-color: white; 
        z-index: 1;
    }

    /* Dotted Leader */
    .menu-dots {
        flex-grow: 1;
        border-bottom: 1px dotted #ccc;
        margin: 0 10px;
        position: relative;
        top: -5px;
    }

    .menu-price {
        font-weight: 700;
        color: #d4af37;
        font-family: 'Roboto', sans-serif;
        background-color: white;
        padding-left: 10px;
        z-index: 1;
    }
  </style>
</head>
<body>

<nav>
  <ul class="nav-flex-row">
    <li class="nav-item"><a href="/index">Home Page</a></li>
    <li class="nav-item"><a href="/reservation">Reservation</a></li>
    <li class="nav-item"><a href="/menu">Menu</a></li>
    <li class="nav-item"><a href="/delivery">Home Delivery</a></li>
    <li class="nav-item"><a href="/about">About</a></li>
  </ul>
