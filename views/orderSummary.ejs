<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Summary - Urban Bites</title>
    
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    
    <link rel="stylesheet" href="/css/orderSummary.css">
</head>
<body style="display: block !important; min-height: 100vh; background-color: #f8f9fa; margin: 0;">

    <nav style="width: 100% !important; display: block !important; background: white; border-bottom: 1px solid #eee; position: relative; z-index: 1000;">
        <ul class="nav-flex-row" style="display: flex; justify-content: center; list-style: none; padding: 15px 0; margin: 0;">
            <li class="nav-item" style="margin: 0 15px;"><a href="/index" style="color: #333; text-decoration: none; text-transform: uppercase; font-weight: 500;">Home Page</a></li>
            <li class="nav-item" style="margin: 0 15px;"><a href="/reservation" style="color: #333; text-decoration: none; text-transform: uppercase; font-weight: 500;">Reservation</a></li>
            <li class="nav-item" style="margin: 0 15px;"><a href="/menu" style="color: #333; text-decoration: none; text-transform: uppercase; font-weight: 500;">Menu</a></li>
            <li class="nav-item" style="margin: 0 15px;"><a href="/delivery" style="color: #333; text-decoration: none; text-transform: uppercase; font-weight: 500;">Home Delivery</a></li>
            <li class="nav-item" style="margin: 0 15px;"><a href="/about" style="color: #333; text-decoration: none; text-transform: uppercase; font-weight: 500;">About</a></li>
        </ul>
    </nav>

    <div class="container" style="max-width: 900px; margin: 40px auto; display: block;">
        <% if (order) { %>
            <div class="receipt-card" style="background: white; border-radius: 15px; box-shadow: 0 15px 35px rgba(0,0,0,0.1); overflow: hidden;">
                <div class="receipt-header" style="background-color: #333; color: #d4af37; padding: 30px; text-align: center; border-bottom: 5px solid #d4af37;">
                    <h2 style="font-family: 'Playfair Display', serif;">Order Summary</h2>
                    <p class="mb-0 text-white-50">Thank you for dining with Urban Bites</p>
                </div>

                <div class="receipt-body" style="padding: 40px;">
                    <div class="row info-group" style="border-bottom: 1px dashed #ddd; margin-bottom: 30px; padding-bottom: 20px;">
                        <div class="col-md-6 border-right">
                            <div class="info-label" style="font-weight: bold; color: #777; font-size: 0.85rem; text-transform: uppercase;">Order ID</div>
                            <div class="info-value text-monospace" style="font-size: 1.1rem; color: #333; margin-bottom: 15px;">#<%= order._id %></div>
                            
                            <div class="info-label" style="font-weight: bold; color: #777; font-size: 0.85rem; text-transform: uppercase;">Date</div>
                            <div class="info-value" style="font-size: 1.1rem; color: #333;"><%= order.createdAt.toLocaleString() %></div>
                        </div>

                        <div class="col-md-6 pl-md-4">
                            <div class="info-label" style="font-weight: bold; color: #777; font-size: 0.85rem; text-transform: uppercase;">Customer Name</div>
                            <div class="info-value" style="font-size: 1.1rem; color: #333; margin-bottom: 15px;">
                                <i class="fas fa-user mr-2 text-warning"></i> <%= order.name %>
                            </div>

                            <div class="info-label" style="font-weight: bold; color: #777; font-size: 0.85rem; text-transform: uppercase;">Contact</div>
                            <div class="info-value" style="font-size: 1.1rem; color: #333; margin-bottom: 15px;">
                                <i class="fas fa-phone mr-2 text-warning"></i> <%= order.phone %>
                            </div>

                            <div class="info-label" style="font-weight: bold; color: #777; font-size: 0.85rem; text-transform: uppercase;">Delivery Address</div>
                            <div class="info-value" style="font-size: 1.1rem; color: #333;">
                                <i class="fas fa-map-marker-alt mr-2 text-warning"></i> <%= order.address %>
                            </div>
                        </div>
                    </div>

                    <h5 class="font-weight-bold mb-3">Items Ordered</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="border-top: none; text-transform: uppercase; font-size: 0.85rem; color: #777;">Item Name</th>
                                    <th class="text-right" style="border-top: none; text-transform: uppercase; font-size: 0.85rem; color: #777;">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.items.forEach(item => { %>
                                    <tr>
                                        <td style="vertical-align: middle; font-weight: 500;"><%= item.name %></td>
                                        <td class="text-right" style="vertical-align: middle; font-weight: 500;">₹<%= item.price.toFixed(2) %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="totals-section" style="background-color: #fcfcfc; border-radius: 10px; padding: 25px; border: 1px solid #eee;">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span>₹<%= order.subtotal.toFixed(2) %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Delivery Fee:</span>
                                    <span>₹<%= order.deliveryFee.toFixed(2) %></span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                                    <span class="text-muted">GST (5%):</span>
                                    <span>₹<%= order.gstAmount.toFixed(2) %></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 font-weight-bold mb-0">Total Due:</span>
                                    <span class="final-total" style="font-family: 'Playfair Display', serif; color: #d4af37; font-weight: 700; font-size: 1.8rem;">₹<%= order.totalPrice.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5">
                        <a href="/made-payment?orderId=<%= order._id %>" class="btn btn-block" style="background-color: #d4af37; color: white; font-weight: bold; padding: 15px; border-radius: 50px;">
                            Proceed to Pay <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                        <div class="text-center mt-3">
                            <a href="/delivery" style="color: #777; text-decoration: none;">
                                <i class="fas fa-arrow-left mr-1"></i> Modify Order / Go Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <div class="card shadow-sm p-5 d-inline-block border-danger">
                    <i class="fas fa-exclamation-triangle text-danger fa-3x mb-3"></i>
                    <h3 class="mb-3">Order Not Found</h3>
                    <p class="text-muted mb-4">We couldn't locate the order details.</p>
                    <a href="/delivery" class="btn btn-outline-dark">Return to Delivery Page</a>
                </div>
            </div>
        <% } %>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>