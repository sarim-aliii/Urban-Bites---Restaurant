<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Urban Bites</title>
    
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .brand-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }

        .auth-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: none;
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }

        .auth-header {
            background-color: #fff;
            padding: 30px 30px 10px 30px;
            text-align: center;
        }

        .auth-body {
            padding: 20px 40px 40px 40px;
        }

        .form-control {
            border-radius: 8px;
            height: 45px;
            border: 1px solid #ced4da;
            padding-left: 15px;
        }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
        }

        .btn-gold {
            background-color: #d4af37;
            border: none;
            color: white;
            font-weight: 500;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .btn-gold:hover {
            background-color: #b39025;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .alert {
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="auth-header">
            <h1 class="brand-title display-4">Urban Bites</h1>
            <p class="text-muted">Set your new password</p>
        </div>

        <div class="auth-body">
            <% if (success && success.length) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> <%= success %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            
            <% if (error && error.length) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>

            <form method="post" action="/resetPassword/<%= token %>">
                <div class="form-group mb-4">
                    <label for="password" class="text-muted small font-weight-bold">NEW PASSWORD</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-control" placeholder="Enter new password" required autofocus>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="confirm" class="text-muted small font-weight-bold">CONFIRM PASSWORD</label>
                    <div class="input-group">
                        <input type="password" id="confirm" name="confirm" class="form-control" placeholder="Confirm new password" required>
                    </div>
                </div>

                <div class="form-group mt-5">
                    <button type="submit" class="btn-gold">
                        Reset Password <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>